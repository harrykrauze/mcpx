{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcpx",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // Publiskie vides mainīgie
  "vars": {
    "ENVIRONMENT": "production",
    "ISSUER_URL": "https://mcpx.harrykrauze.com",
    "RESOURCE_ID": "https://mcpx.harrykrauze.com/mcp/sse"
  },

  // KV krātuve API atslēgām un bilancēm
  "kv_namespaces": [
    {
      "binding": "MCPX_KEYS",
      "id": "10a9a338595d40a5b424d3be11e26860"
    }
  ],

  // Telemetrijas un analītikas dzinējs
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "mcpx_telemetry"
    }
  ],

  // Pieprasījumu biežuma ierobežotājs (Rate limiter)
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ]
}
