{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mcpx",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // Public environment variables
  "vars": {
    "ENVIRONMENT": "production",
    "ISSUER_URL": "https://mcpx.harrykrauze.com",
    "RESOURCE_ID": "https://mcpx.harrykrauze.com/mcp/sse"
  },

  // KV storage for API keys and balances
  "kv_namespaces": [
    {
      "binding": "MCPX_KEYS",
      "id": "10a9a338595d40a5b424d3be11e26860"
    }
  ],

  // Telemetry and analytics engine
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "mcpx_telemetry"
    }
  ],

  // Rate limiter
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 100,
        "period": 60
      }
    }
  ],

  // Cron triggers
  "triggers": {
    "crons": ["0 8 * * *"]
  }
}
