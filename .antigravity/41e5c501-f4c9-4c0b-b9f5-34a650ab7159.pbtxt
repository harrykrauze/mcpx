        value: "node -e \'\nimport(\"dotenv/config\").then(async () => {\n  const { GoogleGenAI } = await import(\"@google/genai\");\n  const ai = new GoogleGenAI({\n    apiKey: process.env.GEMINI_API_KEY,\n    httpOptions: { headers: { \"User-Agent\": \"aistudio-build\" } }\n  });\n  const res = await ai.models.generateContent({\n    model: \"gemini-3.8-flash\",\n    contents: `Convert the following cURL to TypeScript MCP server JSON:\ncurl -X POST \"https://api.resend.com/emails\" -H \"Authorization: Bearer re_123\" -H \"Content-Type: application/json\" -d \"{\\\"from\\\":\\\"a@b.com\\\",\\\"to\\\":\\\"c@d.com\\\"}\"`,\n    config: {\n      temperature: 0.1,\n      responseMimeType: \"application/json\"\n    }\n  });\n  console.log(\"Response text length:\", res.text.length);\n  console.log(\"Sample:\", res.text.substring(0, 200));\n});\n\'"
      }
      metadata {
        key: "task_id"
        value: "41e5c501-f4c9-4c0b-b9f5-34a650ab7159/task-60"
