{
  "name": "mcp-server-generator",
  "description": "Convert cURL commands, OpenAPI 3.0/3.1 specs, and API schemas into production-ready Model Context Protocol (MCP) servers with strict Zod/Pydantic validation.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gemini",
    "openapi",
    "curl",
    "ai-agents"
  ],
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "mcp-server-generator": "./dist/mcp-server.js"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:mcp",
    "start": "tsx server.ts",
    "mcp:start": "tsx src/mcp-server.ts",
    "build:mcp": "esbuild src/mcp-server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/mcp-server.js",
    "test:e2e": "node scripts/test-e2e.mjs --lang=all",
    "test:e2e:ts": "node scripts/test-e2e.mjs --lang=typescript",
    "test:e2e:python": "node scripts/test-e2e.mjs --lang=python",
    "test:tier0": "tsx scripts/test-tier0-verification.ts",
    "test:router": "tsx scripts/test-tier-router.ts",
    "test:l1": "tsx scripts/test-l1-repair.ts",
    "test:l2": "tsx scripts/test-l2-repair.ts",
    "test:pipeline": "tsx scripts/test-circuit-breaker.ts",
    "test:gateway": "tsx scripts/test-remote-gateway.ts",
    "test:security": "tsx scripts/test-sandbox-jev.ts",
    "test:sandbox-escape": "tsx scripts/test-sandbox-escape.ts",
    "test:security-remediation": "tsx scripts/test-security-remediation.ts",
    "test:smoke": "tsx scripts/test-live-smoke.ts",
    "test:live-smoke": "tsx scripts/test-live-smoke.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
