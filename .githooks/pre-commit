#!/usr/bin/env bash
set -e

echo -e "\n\033[38;2;16,185,129m[MCPX HOOK]\033[0m Checking staged TypeScript files prior to commit..."

# Select all staged files with .ts or .tsx extension (excluding deleted files)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep -v -E '(test\.ts|\.d\.ts|node_modules/|scripts/)' || true)

if [ -z "$STAGED_FILES" ]; then
  echo -e "\033[90mNo staged TypeScript files found for inspection. Proceeding with commit.\033[0m\n"
  exit 0
fi

FAILED=0

for FILE in $STAGED_FILES; do
  if [ -f "$FILE" ]; then
    echo -e "\n\033[34m→ Auditing:\033[0m $FILE"
    if ! npm run check -- "$FILE"; then
      echo -e "\033[31m✖ mcpx audit rejected file:\033[0m $FILE"
      FAILED=1
    fi
  fi
done

if [ $FAILED -ne 0 ]; then
  echo -e "\n\033[31m[BLOCKED]\033[0m Commit aborted due to security or syntax violations detected by mcpx gateway."
  echo -e "Resolve the errors or, if strictly necessary, commit with 'git commit --no-verify'.\n"
  exit 1
fi

echo -e "\n\033[32m✔ All staged files successfully verified against mcpx edge gateway.\033[0m Proceeding with commit...\n"
exit 0
